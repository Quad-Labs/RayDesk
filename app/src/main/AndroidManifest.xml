<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for Moonlight streaming -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Features -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="true" />

    <application
        android:name=".RayDeskApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RayDesk"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <!-- Required: identifies this as a native Mercury app (not App Lab) -->
        <meta-data
            android:name="com.rayneo.mercury.app"
            android:value="true" />

        <!-- Connection Activity - Main Launcher (Server Selection) -->
        <activity
            android:name="com.raydesk.ui.ConnectionActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.RayDesk">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Streaming Activity - Launched from ConnectionActivity -->
        <activity
            android:name="com.raydesk.ui.StreamingActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.RayDesk" />

        <!-- Cursor Settings Activity -->
        <activity
            android:name="com.raydesk.ui.CursorSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.RayDesk" />

        <!-- Moonlight Discovery Service for mDNS server discovery -->
        <service
            android:name="com.limelight.discovery.DiscoveryService"
            android:label="mDNS PC Auto-Discovery Service" />

        <!-- Moonlight Computer Manager Service -->
        <service
            android:name="com.limelight.computers.ComputerManagerService"
            android:label="Computer Manager Service" />

    </application>

</manifest>
