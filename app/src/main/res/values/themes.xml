<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- RayDesk Dark Theme - optimized for AR glasses -->
    <style name="Theme.RayDesk" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/rayneo_cyan</item>
        <item name="colorPrimaryVariant">@color/rayneo_cyan</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/rayneo_green</item>
        <item name="colorSecondaryVariant">@color/rayneo_green</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Background - must be black for AR transparency -->
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>

        <!-- Status bar - immersive -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
